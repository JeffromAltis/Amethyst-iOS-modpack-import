+// ---------------------------------------------------------------------------------------------
+// Amethyst: zero-copy BGRA and packed 8_8_8_8 uploads
+//
+// Desktop GL code (e.g. Minecraft 1.12.2's TextureUtil) uploads GL_BGRA/GL_UNSIGNED_INT_8_8_8_8_REV pixels.
+// GLES has neither GL_BGRA nor the packed 8_8_8_8 types, but on a little-endian CPU each of those layouts is
+// just four bytes in some order. So the bytes are uploaded unchanged as GL_RGBA/GL_UNSIGNED_BYTE and the
+// texture gets a swizzle that puts the channels back when it is sampled, with no per-pixel work on the CPU.
+// A texture keeps the order it was allocated with; the rare upload in a different order is converted.
+
+enum PixelOrder : unsigned char { ORDER_RGBA = 0, ORDER_BGRA, ORDER_ARGB, ORDER_ABGR, ORDER_NONE = 0xFF };
+
+// Memory byte order of a 4x8-bit format/type pair, or ORDER_NONE for anything else.
+static PixelOrder pixel_order(GLenum format, GLenum type) {
+    if (format != GL_RGBA && format != GL_BGRA) return ORDER_NONE;
+    bool bgra = format == GL_BGRA;
+    switch (type) {
+    case GL_UNSIGNED_BYTE:
+    case GL_UNSIGNED_INT_8_8_8_8_REV:
+        return bgra ? ORDER_BGRA : ORDER_RGBA;
+    case GL_UNSIGNED_INT_8_8_8_8:
+        return bgra ? ORDER_ARGB : ORDER_ABGR;
+    default:
+        return ORDER_NONE;
+    }
+}
+
+// Byte position of R, G, B and A for each order
+static const int kOrderPositions[4][4] = {
+    {0, 1, 2, 3}, // RGBA
+    {2, 1, 0, 3}, // BGRA
+    {1, 2, 3, 0}, // ARGB
+    {3, 2, 1, 0}, // ABGR
+};
+
+// Swizzle that samples R, G, B, A from bytes stored in the given order, as if they were RGBA
+static const GLint kOrderSwizzles[4][4] = {
+    {GL_RED, GL_GREEN, GL_BLUE, GL_ALPHA},
+    {GL_BLUE, GL_GREEN, GL_RED, GL_ALPHA},
+    {GL_GREEN, GL_BLUE, GL_ALPHA, GL_RED},
+    {GL_ALPHA, GL_BLUE, GL_GREEN, GL_RED},
+};
+
+static bool is_rgba8_internal_format(GLint internalFormat) {
+    return internalFormat == GL_RGBA || internalFormat == GL_RGBA8;
+}
+
+static void set_texture_pixel_order(GLenum target, TextureObject* tex, PixelOrder order) {
+    const GLint* swizzle = kOrderSwizzles[order];
+    if (tex) {
+        tex->pixel_order = order;
+        memcpy(tex->swizzle_param, swizzle, sizeof(tex->swizzle_param));
+    }
+    GLES.glTexParameteri(target, GL_TEXTURE_SWIZZLE_R, swizzle[0]);
+    GLES.glTexParameteri(target, GL_TEXTURE_SWIZZLE_G, swizzle[1]);
+    GLES.glTexParameteri(target, GL_TEXTURE_SWIZZLE_B, swizzle[2]);
+    GLES.glTexParameteri(target, GL_TEXTURE_SWIZZLE_A, swizzle[3]);
+}
+
+// Uploads `pixels` (in `from` order) into a texture stored in `to` order, converting on the CPU.
+// Only used when an upload's order differs from the texture's, which is rare.
+static void upload_reordered(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLsizei width, GLsizei height,
+                             PixelOrder from, PixelOrder to, const void* pixels) {
+    GLint unpackBuffer = 0;
+    GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpackBuffer);
+    if (unpackBuffer != 0 || pixels == nullptr || width <= 0 || height <= 0) {
+        // Data lives in a buffer object; upload as is (channels may come out swapped)
+        LOG_E("Amethyst: can't reorder a %dx%d upload from a pixel buffer", width, height)
+        GLES.glTexSubImage2D(target, level, xoffset, yoffset, width, height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+        return;
+    }
+    GLint rowLength = 0, skipPixels = 0, skipRows = 0, alignment = 4;
+    GLES.glGetIntegerv(GL_UNPACK_ROW_LENGTH, &rowLength);
+    GLES.glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &skipPixels);
+    GLES.glGetIntegerv(GL_UNPACK_SKIP_ROWS, &skipRows);
+    GLES.glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+    size_t srcStride = (size_t)(rowLength > 0 ? rowLength : width) * 4;
+    if (alignment > 4) srcStride = (srcStride + alignment - 1) / alignment * alignment;
+    const unsigned char* src = (const unsigned char*)pixels + (size_t)skipRows * srcStride + (size_t)skipPixels * 4;
+
+    std::vector<unsigned char> converted((size_t)width * height * 4);
+    const int* fromPos = kOrderPositions[from];
+    const int* toPos = kOrderPositions[to];
+    for (GLsizei y = 0; y < height; y++) {
+        const unsigned char* in = src + (size_t)y * srcStride;
+        unsigned char* out = converted.data() + (size_t)y * width * 4;
+        for (GLsizei x = 0; x < width; x++, in += 4, out += 4) {
+            for (int c = 0; c < 4; c++) out[toPos[c]] = in[fromPos[c]];
+        }
+    }
+
+    GLES.glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    GLES.glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+    GLES.glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+    GLES.glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    GLES.glTexSubImage2D(target, level, xoffset, yoffset, width, height, GL_RGBA, GL_UNSIGNED_BYTE, converted.data());
+    GLES.glPixelStorei(GL_UNPACK_ROW_LENGTH, rowLength);
+    GLES.glPixelStorei(GL_UNPACK_SKIP_PIXELS, skipPixels);
+    GLES.glPixelStorei(GL_UNPACK_SKIP_ROWS, skipRows);
+    GLES.glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+}
