diff --git a/src/main/cpp/gl/getter.cpp b/src/main/cpp/gl/getter.cpp
index 42478b7..467eef4 100644
--- a/src/main/cpp/gl/getter.cpp
+++ b/src/main/cpp/gl/getter.cpp
@@ -79,6 +79,32 @@ void glGetIntegerv(GLenum pname, GLint *params) {
         case GL_VERTEX_ARRAY_BINDING:
             (*params) = (int) find_bound_array();
             break;
+        // Amethyst: limits of desktop GL's fixed-function pipeline, which GLES doesn't have (it
+        // reports an error and leaves 0, and e.g. Angelica sizes its matrix stacks from these).
+        // Values are what Mesa reports for a compatibility context.
+        case 0x0D31: // GL_MAX_LIGHTS
+            (*params) = 8;
+            break;
+        case 0x0D35: // GL_MAX_ATTRIB_STACK_DEPTH
+        case 0x0D3B: // GL_MAX_CLIENT_ATTRIB_STACK_DEPTH
+            (*params) = 16;
+            break;
+        case 0x0D36: // GL_MAX_MODELVIEW_STACK_DEPTH
+            (*params) = 32;
+            break;
+        case 0x0D37: // GL_MAX_NAME_STACK_DEPTH
+            (*params) = 64;
+            break;
+        case 0x0D38: // GL_MAX_PROJECTION_STACK_DEPTH
+            (*params) = 32;
+            break;
+        case 0x0D39: // GL_MAX_TEXTURE_STACK_DEPTH
+            (*params) = 10;
+            break;
+        case 0x84E2: // GL_MAX_TEXTURE_UNITS (fixed-function texture units)
+        case 0x8871: // GL_MAX_TEXTURE_COORDS
+            (*params) = 8;
+            break;
         default:
             GLES.glGetIntegerv(pname, params);
             LOG_D("  -> %d",*params)
