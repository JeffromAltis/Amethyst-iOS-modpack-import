diff --git a/src/main/cpp/gl/framebuffer.cpp b/src/main/cpp/gl/framebuffer.cpp
index df4b096..ea548f3 100644
--- a/src/main/cpp/gl/framebuffer.cpp
+++ b/src/main/cpp/gl/framebuffer.cpp
@@ -6,6 +6,7 @@
 #include "log.h"
 #include "../config/settings.h"
 #include "FSR1/FSR1.h"
+#include <unordered_set>
 
 #define DEBUG 0
 
@@ -167,8 +168,36 @@ void glReadBuffer(GLenum src) {
         GLES.glReadBuffer(src);
     }
 }
+// Renderbuffers allocated with a packed depth+stencil format. Desktop GL code (e.g. Minecraft 1.12.2's
+// Framebuffer.enableStencil) attaches such a buffer to GL_DEPTH_ATTACHMENT and GL_STENCIL_ATTACHMENT
+// separately; ANGLE's Metal backend then fails to complete the framebuffer (glCheckFramebufferStatus
+// returns 0), so attach it once as GL_DEPTH_STENCIL_ATTACHMENT instead.
+static std::unordered_set<GLuint> packed_depth_stencil_renderbuffers;
+
+void mg_note_renderbuffer_storage(GLenum internalFormat) {
+    GLint bound = 0;
+    GLES.glGetIntegerv(GL_RENDERBUFFER_BINDING, &bound);
+    if (bound == 0) return;
+    if (internalFormat == GL_DEPTH24_STENCIL8 || internalFormat == GL_DEPTH32F_STENCIL8 || internalFormat == GL_DEPTH_STENCIL) {
+        packed_depth_stencil_renderbuffers.insert((GLuint) bound);
+    } else {
+        packed_depth_stencil_renderbuffers.erase((GLuint) bound);
+    }
+}
+
+void glFramebufferRenderbuffer(GLenum target, GLenum attachment, GLenum renderbuffertarget, GLuint renderbuffer) {
+    if ((attachment == GL_DEPTH_ATTACHMENT || attachment == GL_STENCIL_ATTACHMENT) && renderbuffer != 0 &&
+        packed_depth_stencil_renderbuffers.count(renderbuffer)) {
+        attachment = GL_DEPTH_STENCIL_ATTACHMENT;
+    }
+    GLES.glFramebufferRenderbuffer(target, attachment, renderbuffertarget, renderbuffer);
+}
+
 GLenum glCheckFramebufferStatus(GLenum target) {
     GLenum status = GLES.glCheckFramebufferStatus(target);
+    if (status == 0) {
+        printf("[MobileGlues] glCheckFramebufferStatus(0x%x) returned 0, glGetError = 0x%x\n", target, GLES.glGetError());
+    }
     if (global_settings.ignore_error == IgnoreErrorLevel::Full && status != GL_FRAMEBUFFER_COMPLETE) {
         return GL_FRAMEBUFFER_COMPLETE;
     }
